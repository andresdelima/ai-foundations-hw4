# Copy this file to .env and fill in your own values. Never commit or share the real .env.
# The backend also finds a .env in a parent folder (for example the course root).

# Portkey API key (required). Placeholder only. Replace it with your own key.
PORTKEY_API_KEY=your-portkey-api-key-here

# Portkey gateway URL (optional; this is the default).
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# Model for the shopping agent (optional; this is the default; gpt-6-astra also works).
CAMPUS_MODEL=gpt-5.6
